# Copy pasted from https://www.pythoncentral.io/python-gitignore-clean-repository-management/
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
ENV/
.env/
.venv/

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# Jupyter Notebook
.ipynb_checkpoints

# Suggested by AI (Anthropic Claude Sonnet 5.5)
# Secrets and local configuration files
.env
.env.*
!.env.example

# Caches for tools
.ruff_cache/
.pytest_cache/

# Editors
.idea/
.vscode/